10 REM CELSIUS TO FAHRENHEIT CONVERTER FOR APPLE II BASIC
20 HOME
30 PRINT CHR$(27); "E"
40 COLOR= 11
50 PRINT "   CELSIUS TO FAHRENHEIT CONVERTER"
60 PRINT
70 COLOR= 10
80 PRINT "ENTER DEGREES CELSIUS: ";
90 INPUT C
100 F = C * 9 / 5 + 32
110 HOME
120 COLOR= 5
130 PRINT "CELSIUS:   "; C
140 COLOR= 12
150 PRINT "FAHRENHEIT:"; F
160 PRINT
170 COLOR= 14
180 PRINT "PRESS RETURN FOR ANOTHER CONVERSION"
190 INPUT A$
200 GOTO 10

